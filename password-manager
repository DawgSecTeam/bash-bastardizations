#!/bin/bash

if [ "$(id -u)" -ne 0 ]; then
  printf "passwd: You may not view or modify password information for $1\nHint: use sudo to set the password for other users\n"
  exit 1
fi


SAVE_TO="/var/cache/passwd"

touch $SAVE_TO

printf "New passwd:\n"

# pass along to systemd

printf "Thanks for the password\n"
